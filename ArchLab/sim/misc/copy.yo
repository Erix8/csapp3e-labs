                            | # copy.ys - 复制内存块并返回源数据的异或校验和
                            | # 作者：刘和磊
                            | # 学号：2023012122
                            | # 功能：等价于C函数copy_block，复制src到dest（非重叠），返回异或和
                            | 
                            | 
                            | # Execution begins at address 0 
0x000:                      | 	.pos 0
0x000: 30f40002000000000000 | 	irmovq stack, %rsp  	# Set up stack pointer
0x00a: 804800000000000000   | 	call main		# Execute main program
0x013: 00                   | 	halt			# Terminate program 
                            | 
                            | # 数据段：测试用源数据和目标数据块
0x018:                      | .align 8
                            | # Source block
0x018:                      | src:
0x018: 0a00000000000000     |     .quad 0x00a
0x020: b000000000000000     |     .quad 0x0b0
0x028: 000c000000000000     |     .quad 0xc00
                            | # Destination block
0x030:                      | dest:
0x030: 1101000000000000     |     .quad 0x111
0x038: 2202000000000000     |     .quad 0x222
0x040: 3303000000000000     |     .quad 0x333
                            | 
                            | # 代码段
0x048:                      | main:
                            |     # 函数调用准备：copy_block(src, dest, 3)
0x048: 30f71800000000000000 |     irmovq src, %rdi      # 第一个参数：src指针
0x052: 30f63000000000000000 |     irmovq dest, %rsi     # 第二个参数：dest指针
0x05c: 30f20300000000000000 |     irmovq $3, %rdx       # 第三个参数：长度len=3
0x066: 807000000000000000   |     call copy_block       # 调用复制函数
0x06f: 00                   |     halt                  # 程序终止，%rax存储异或校验和
                            | 
                            | # copy_block函数：long copy_block(long *src, long *dest, long len)
                            | # 参数：%rdi = src, %rsi = dest, %rdx = len
                            | # 返回值：%rax = 异或校验和
0x070:                      | copy_block:
                            |     # 函数序言
0x070: a05f                 |     pushq %rbp
0x072: 2045                 |     rrmovq %rsp, %rbp
                            | 
                            |     # 初始化result = 0
0x074: 6300                 |     xorq %rax, %rax       # %rax = 0（异或和初始值）
                            | 
0x076:                      | copy_loop:
                            |     # 判断len是否为0：若%rdx == 0，跳至循环结束
0x076: 6222                 |     andq %rdx, %rdx
0x078: 73ba00000000000000   |     je copy_end
                            | 
                            |     # 读取src当前值并复制到dest
0x081: 50a70000000000000000 |     mrmovq (%rdi), %r10   # %r10 = *src
0x08b: 40a60000000000000000 |     rmmovq %r10, (%rsi)   # *dest = %r10
                            | 
                            |     # 更新异或和：result ^= val
0x095: 63a0                 |     xorq %r10, %rax
                            | 
                            |     # 指针递增（long为8字节）、长度递减
0x097: 30fb0800000000000000 |     irmovq $8, %r11
0x0a1: 60b7                 |     addq %r11, %rdi       # src++
0x0a3: 60b6                 |     addq %r11, %rsi       # dest++
0x0a5: 30fb0100000000000000 |     irmovq $1, %r11
0x0af: 61b2                 |     subq %r11, %rdx       # len--
                            | 
0x0b1: 707600000000000000   |     jmp copy_loop
                            | 
0x0ba:                      | copy_end:
                            |     # 函数结语
0x0ba: 2054                 |     rrmovq %rbp, %rsp
0x0bc: b05f                 |     popq %rbp
0x0be: 90                   |     ret                   # 返回%rax中的异或校验和
                            | 
                            | # Stack starts here and grows to lower addresses
0x200:                      | 	.pos 0x200
0x200:                      | stack:
