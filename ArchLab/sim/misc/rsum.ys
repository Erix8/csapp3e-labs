# rsum.ys - Recursive linked-list sum
# Author: Erix8
# Equivalent to the C function rsum_list

# Execution begins at address 0 
	.pos 0
	irmovq stack, %rsp  	# Set up stack pointer
	call main		# Execute main program
	halt			# Terminate program 

# Data: test linked list (3 elements)
.align 8
ele1:
    .quad 0x00a
    .quad ele2
ele2:
    .quad 0x0b0
    .quad ele3
ele3:
    .quad 0xc00
    .quad 0
# END

# Code
main:
    irmovq ele1, %rdi     # arg1 = head of list
    call rsum_list
    halt

# rsum_list: long rsum_list(list_ptr ls)
# %rdi = ls, returns sum in %rax
rsum_list:
    pushq %rbp            # Save old frame pointer
    rrmovq %rsp, %rbp
    pushq %r10            # Save callee-saved r10

    andq %rdi, %rdi       # base case: ls == NULL?
    je base_case

    mrmovq (%rdi), %r10   # r10 = ls->val
    mrmovq 8(%rdi), %rdi  # ls = ls->next
    call rsum_list        # recurse, result in %rax
    addq %r10, %rax       # return ls->val + rest
    jmp return

base_case:
    xorq %rax, %rax       # return 0

return:
    popq %r10             # Restore callee-saved r10
    rrmovq %rbp, %rsp     # Restore stack
    popq %rbp
    ret

# Stack starts here and grows to lower addresses
	.pos 0x200
stack:
