                            | # sum.ys - 迭代求和链表元素
                            | # 作者：刘和磊
                            | # 学号：2023012122
                            | # 功能：等价于C函数sum_list，迭代遍历链表并累加元素值
                            | 
                            | # Execution begins at address 0 
0x000:                      | 	.pos 0
0x000: 30f40002000000000000 | 	irmovq stack, %rsp  	# Set up stack pointer
0x00a: 804800000000000000   | 	call main		# Execute main program
0x013: 00                   | 	halt			# Terminate program 
                            | 
                            | # 数据段：测试用三元素链表
0x018:                      | .align 8
0x018:                      | ele1:
0x018: 0a00000000000000     |     .quad 0x00a
0x020: 2800000000000000     |     .quad ele2
0x028:                      | ele2:
0x028: b000000000000000     |     .quad 0x0b0
0x030: 3800000000000000     |     .quad ele3
0x038:                      | ele3:
0x038: 000c000000000000     |     .quad 0xc00
0x040: 0000000000000000     |     .quad 0
                            | # END
                            | 
                            | # 代码段
0x048:                      | main:
                            |     # 函数调用准备：sum_list(ele1)
0x048: 30f71800000000000000 |     irmovq ele1, %rdi     # 第一个参数：链表头指针ele1存入%rdi
0x052: 805c00000000000000   |     call sum_list         # 调用sum_list函数
0x05b: 00                   |     halt                  # 程序终止
                            | 
                            | # sum_list函数：long sum_list(list_ptr ls)
                            | # 参数：%rdi = ls（链表头指针）
                            | # 返回值：%rax = 累加和
0x05c:                      | sum_list:
                            |     # 函数序言：保存被调用者保存寄存器（无使用，仅遵循调用约定）
0x05c: a05f                 |     pushq %rbp            # 建立栈帧
0x05e: 2045                 |     rrmovq %rsp, %rbp
                            | 
                            |     # 初始化val = 0
0x060: 6300                 |     xorq %rax, %rax       # %rax = 0（累加和初始值）
                            | 
0x062:                      | loop_start:
                            |     # 判断ls是否为NULL：若%rdi == 0，跳至循环结束
0x062: 6277                 |     andq %rdi, %rdi
0x064: 738c00000000000000   |     je loop_end
                            | 
                            |     # 读取ls->val：(%rdi)存储val，%rdi+8存储next指针
0x06d: 50a70000000000000000 |     mrmovq (%rdi), %r10   # %r10 = ls->val
0x077: 60a0                 |     addq %r10, %rax       # val += ls->val
                            | 
                            |     # 更新ls = ls->next
0x079: 50770800000000000000 |     mrmovq 8(%rdi), %rdi  # %rdi = ls->next
0x083: 706200000000000000   |     jmp loop_start        # 回到循环开头
                            | 
0x08c:                      | loop_end:
                            |     # 函数结语：恢复栈帧
0x08c: 2054                 |     rrmovq %rbp, %rsp
0x08e: b05f                 |     popq %rbp
0x090: 90                   |     ret                   # 返回%rax中的累加和
                            | 
                            | # Stack starts here and grows to lower addresses
0x200:                      | 	.pos 0x200
0x200:                      | stack:
